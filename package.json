{
  "name": "@local/dsh-prompt-manager",
  "version": "1.3.0",
  "private": true,
  "description": "DSH（DeepSeek Harness）提示词管理器：按标签分组管理提示词，一键写进输入框；并用大模型优化输入框里正在写的东西",
  "type": "module",
  "icon": "./icon.svg",
  "dshTitle": {
    "zh": "提示词管理器",
    "en": "Prompt Manager"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt-manager",
    "prompt-library",
    "tags"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
